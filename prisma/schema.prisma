generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            Int      @id @default(autoincrement())
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  workRecords   WorkRecord[]
  deductions    Deduction[]
  payrolls      Payroll[]
  employeeRates EmployeeRate[]

  @@map("employees")
}

model RateRule {
  id              Int     @id @default(autoincrement())
  dayOfWeek       Int     @map("day_of_week")
  dayName         String  @map("day_name")
  maxRegularHours Float   @default(8) @map("max_regular_hours")
  regularRate     Float   @default(2.50) @map("regular_rate")
  overtimeRate    Float   @default(3.00) @map("overtime_rate")
  lunchDuration   Float   @default(0.5) @map("lunch_duration")
  isActive        Boolean @default(true) @map("is_active")

  @@map("rate_rules")
}

model WorkRecord {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  date          String
  entryTime     String?  @map("entry_time")
  exitTime      String?  @map("exit_time")
  directHours   Float?   @map("direct_hours")
  isDirectEntry Boolean  @default(false) @map("is_direct_entry")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("work_records")
}

model Deduction {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  date        String
  type        String
  amount      Float
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("deductions")
}

model EmployeeRate {
  id              Int     @id @default(autoincrement())
  employeeId      Int     @map("employee_id")
  dayOfWeek       Int     @map("day_of_week")
  maxRegularHours Float   @default(8) @map("max_regular_hours")
  regularRate     Float   @default(2.50) @map("regular_rate")
  overtimeRate    Float   @default(3.00) @map("overtime_rate")
  lunchDuration   Float   @default(0.5) @map("lunch_duration")
  isActive        Boolean @default(true) @map("is_active")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_rates")
}

model Payroll {
  id                  Int      @id @default(autoincrement())
  employeeId          Int      @map("employee_id")
  periodStart         String   @map("period_start")
  periodEnd           String   @map("period_end")
  totalRegularHours   Float    @default(0) @map("total_regular_hours")
  totalOvertimeHours  Float    @default(0) @map("total_overtime_hours")
  regularPay          Float    @default(0) @map("regular_pay")
  overtimePay         Float    @default(0) @map("overtime_pay")
  totalDeductions     Float    @default(0) @map("total_deductions")
  netPay              Float    @default(0) @map("net_pay")
  paidAt              DateTime? @map("paid_at")
  createdAt           DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payroll")
}
